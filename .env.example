# RinkStop Scoresheet — environment variables
# Copy this file to `.env.local` and fill in real values before running.

# --- Supabase (shared with rinkstop-platform main app) ---
# Get from Supabase Dashboard → Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Clerk (shared with rinkstop-platform main app) ---
# Get from Clerk Dashboard → API Keys
# Use the SAME Clerk instance as the main app so users share one account.
CLERK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx

# --- Optional: site URL for redirects ---
# Defaults to http://localhost:3000 if unset
NEXT_PUBLIC_SITE_URL=http://localhost:3000
